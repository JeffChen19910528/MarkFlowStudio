{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkFlow Studio",
  "version": "0.1.0",
  "identifier": "studio.markflow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkFlow Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "MarkFlow Studio",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["TradChinese", "English"] } }
  }
}
